{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix motion-lab ci",
  "buildCommand": "npm --prefix motion-lab run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/lab/motion", "destination": "/lab/index.html" },
    { "source": "/lab/motion/", "destination": "/lab/index.html" }
  ]
}
